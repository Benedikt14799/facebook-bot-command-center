# --------------------------------------------------------------------------
# FB-Control Kommandozentrale -- Beispiel-Umgebungsvariablen
# Kopieren nach .env und mit echten Werten fuellen:  cp .env.example .env
# Auf Lovable Cloud werden die Supabase-Werte automatisch gesetzt.
# --------------------------------------------------------------------------

# --- Client (Browser-Bundle, Pflicht) -------------------------------------
VITE_SUPABASE_URL=https://<projekt-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=<projekt-ref>

# --- Server (Serverfunktionen, Cron, Worker-API) --------------------------
SUPABASE_URL=https://<projekt-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Nur serverseitig verwenden, niemals ins Frontend geben:
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# --- Optional -------------------------------------------------------------
# Schluessel fuer die KI-Textgenerierung (Lovable AI Gateway).
# Fehlt er, nutzen Auftraege ausschliesslich Vorlagen.
LOVABLE_API_KEY=

# --- Worker ---------------------------------------------------------------
# Diese Werte gehoeren in die .env des lokalen Playwright-Workers,
# nicht in die Web-App. Das Token wird im Cockpit unter "Worker" erzeugt.
# WORKER_TOKEN=
# WORKER_BASE_URL=https://<deine-app>.lovable.app

# --- Worker (lokaler Rechner / VPS, nicht in dieser App) ------------------
# Diese Werte gehoeren in die Umgebung des Workers, nicht in das Cockpit:
# FB_CONTROL_BASE_URL=https://<projekt>.lovable.app
# FB_CONTROL_WORKER_TOKEN=<Schluessel aus dem Cockpit, nie im Skript>
# FB_CONTROL_WORKER_ID=<optional>
# FB_CONTROL_BOT_ID=<optional>
# FB_CONTROL_MODE=dry_run
